# Staging uses production security checks, with isolated data and credentials.
APP_ENV=staging
NODE_ENV=production
PORT=3001
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=
CORS_ORIGINS=
REDIS_URL=
REDIS_NAMESPACE=totmart:staging
# Example only: verify actual trusted proxy hops before using 1.
TRUST_PROXY=1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
FROM_EMAIL=
# For initial fixture tests use independent staging credentials, not the production webhook.
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
ORDER_EXPIRY_HOURS=24
# Bootstrap only; configure temporarily and remove after accounts are created.
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_MERCHANT_EMAIL=
STAGING_MERCHANT_PASSWORD=
STAGING_CUSTOMER_EMAIL=
STAGING_CUSTOMER_PASSWORD=
