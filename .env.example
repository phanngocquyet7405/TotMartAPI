# ==== Server ====
PORT=3001
NODE_ENV=development

# ==== Database ====
MONGODB_URI=mongodb://localhost:27017/totmart?replicaSet=rs0
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_MAX_COMMIT_TIME_MS=10000
MONGO_TRANSACTION_TIMEOUT_MS=15000

# ==== JWT ====
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ==== Frontend (dùng để build link reset-password, v.v — KHÔNG phải domain của API này) ====
FRONTEND_URL=https://totmart.vn

# ==== CORS ====
# Danh sách domain FE được phép gọi API, phân cách bởi dấu phẩy.
# Nếu bỏ trống, hệ thống sẽ fallback dùng FRONTEND_URL ở trên.
CORS_ORIGINS=https://totmart.vn,https://admin.totmart.vn

# ==== Email (Brevo) ====
BREVO_API_KEY=
FROM_EMAIL=

# ==== Cloudinary (upload ảnh) ====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== SePay (thanh toán online qua chuyển khoản) ====
# API key để xác thực webhook — lấy khi tạo webhook trên dashboard SePay (chọn Api_Key auth type)
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=

# ==== Đơn hàng ====
# Số giờ 1 đơn online chưa thanh toán sẽ bị tự động huỷ
ORDER_EXPIRY_HOURS=24

# Shared security/rate limit store. Required in production.
# Development: leave empty for one instance only. Production: rediss://...
REDIS_URL=
REDIS_NAMESPACE=totmart:development
# Number/name of trusted reverse proxies; required in production (e.g. 1 behind Render/Nginx/Cloudflare).
# If running directly without reverse proxy in production (TRUST_PROXY=0), set TRUST_PROXY_CONFIRMED_DIRECT=true
# to acknowledge direct mode and silence the startup warning.
TRUST_PROXY=0
TRUST_PROXY_CONFIRMED_DIRECT=false
